#include <cstdint>
#include "acl/acl.h"
#include "kernel_operator.h"
#include "kernel_tiling/kernel_tiling.h"
#include "tiling/platform/platform_ascendc.h"
#include "tiling/tiling_api.h"
#include "lib/matmul_intf.h"

// Experiment: distribute M row tiles across AIVs while retaining the passed
// GM C-tile transport. This isolates parallel scheduling from VECIN behavior.
// The runner supplies TensorInfo and TensorGroupInfo before including this file.
namespace bmms_parallel_gm {
constexpr int32_t MAX_ROWS = 16;
constexpr int32_t BATCH_GROUP = 16; // One writer per 64-byte output interval.
constexpr int32_t PARTIAL_STRIDE = 16; // One 64-byte cache line per row tile.

template<class T, bool TA, bool TB>
__schedmode__(1) __global__ __mix__(1, 2) void FlashMaxSum(
    GM_ADDR a, GM_ADDR b, GM_ADDR y, GM_ADDR partials, GM_ADDR tiles,
    __kfc_workspace__ GM_ADDR workspace, AscendC::tiling::TCubeTiling tiling,
    int32_t batch, int32_t m, int32_t n, int32_t k,
    int32_t tileRows, int32_t tilesPerBatch, int32_t workers)
{
    AscendC::TPipe pipe;
    matmul::Matmul<
        matmul::MatmulType<AscendC::TPosition::GM, CubeFormat::ND, T, TA>,
        matmul::MatmulType<AscendC::TPosition::GM, CubeFormat::ND, T, TB>,
        matmul::MatmulType<AscendC::TPosition::GM, CubeFormat::ND, float>,
        matmul::MatmulType<AscendC::TPosition::GM, CubeFormat::ND, float>> mm;
    REGIST_MATMUL_OBJ(&pipe, GetSysWorkSpacePtr(), mm, &tiling);

    AscendC::GlobalTensor<T> ag, bg;
    AscendC::GlobalTensor<float> yg, pg, cg;
    ag.SetGlobalBuffer(reinterpret_cast<__gm__ T*>(a));
    bg.SetGlobalBuffer(reinterpret_cast<__gm__ T*>(b));
    yg.SetGlobalBuffer(reinterpret_cast<__gm__ float*>(y));
    pg.SetGlobalBuffer(reinterpret_cast<__gm__ float*>(partials));
    cg.SetGlobalBuffer(reinterpret_cast<__gm__ float*>(tiles) +
        static_cast<int64_t>(AscendC::GetBlockIdx()) * MAX_ROWS * tiling.baseN);

    AscendC::TQue<AscendC::TPosition::VECIN, 1> cq;
    AscendC::TQue<AscendC::TPosition::VECOUT, 1> oq;
    AscendC::TQue<AscendC::TPosition::VECOUT, 1> pq;
    AscendC::TBuf<AscendC::TPosition::VECCALC> scratch, reduced;
    pipe.InitBuffer(cq, 1, tileRows * tiling.baseN * sizeof(float));
    pipe.InitBuffer(oq, 1, BATCH_GROUP * sizeof(float));
    pipe.InitBuffer(pq, 1, PARTIAL_STRIDE * sizeof(float));
    pipe.InitBuffer(scratch, 32768);
    pipe.InitBuffer(reduced, tileRows * PARTIAL_STRIDE * sizeof(float));
    auto tmp = scratch.Get<float>();
    auto tileMax = reduced.Get<float>();

    const int32_t wid = AscendC::GetBlockIdx();
    const int32_t totalTiles = batch * tilesPerBatch;
    for (int32_t task = wid; task < totalTiles; task += workers) {
        const int32_t bi = task / tilesPerBatch;
        const int32_t mi = (task % tilesPerBatch) * tileRows;
        const int32_t validM = m - mi < tileRows ? m - mi : tileRows;
        const int64_t batchA = static_cast<int64_t>(bi) * m * k;
        const int64_t batchB = static_cast<int64_t>(bi) * k * n;
        const int64_t ao = batchA + (TA ? mi : static_cast<int64_t>(mi) * k);
        float running[MAX_ROWS];
        for (int32_t r = 0; r < validM; ++r) running[r] = -__builtin_inff();

        for (int32_t ni = 0; ni < n; ni += tiling.baseN) {
            const int32_t validN = n - ni < tiling.baseN ? n - ni : tiling.baseN;
            const int64_t bo = batchB + (TB ? static_cast<int64_t>(ni) * k : ni);
            mm.SetOrgShape(m, n, k, k, tiling.baseN);
            mm.SetTail(validM, validN, k);
            mm.SetTensorA(ag[ao], TA);
            mm.SetTensorB(bg[bo], TB);
            // This C-tile path matches the 15/15-pass version, including
            // explicit output stride for an N tail.
            mm.template IterateAll<true>(cg, 0, false);
            mm.End();
            auto c = cq.AllocTensor<float>();
            AscendC::DataCopy(c, cg, MAX_ROWS * tiling.baseN);
            cq.EnQue(c);
            c = cq.DeQue<float>();
            for (int32_t r = 0; r < validM; ++r) {
                AscendC::ReduceMax(tileMax[r * PARTIAL_STRIDE],
                    c[r * tiling.baseN], tmp, validN, false);
                AscendC::PipeBarrier<PIPE_V>();
            }
            AscendC::SetFlag<AscendC::HardEvent::V_S>(EVENT_ID0);
            AscendC::WaitFlag<AscendC::HardEvent::V_S>(EVENT_ID0);
            for (int32_t r = 0; r < validM; ++r) {
                const float v = tileMax.GetValue(r * PARTIAL_STRIDE);
                running[r] = running[r] > v ? running[r] : v;
            }
            cq.FreeTensor(c);
        }
        float partial = 0.0f;
        for (int32_t r = 0; r < validM; ++r) partial += running[r];
        auto partOut = pq.AllocTensor<float>();
        partOut.SetValue(0, partial);
        AscendC::SetFlag<AscendC::HardEvent::S_MTE3>(EVENT_ID0);
        AscendC::WaitFlag<AscendC::HardEvent::S_MTE3>(EVENT_ID0);
        pq.EnQue(partOut);
        partOut = pq.DeQue<float>();
        AscendC::DataCopyExtParams partCopy{1, sizeof(float), 0, 0, 0};
        AscendC::DataCopyPad(pg[static_cast<int64_t>(task) * PARTIAL_STRIDE],
            partOut, partCopy);
        pq.FreeTensor(partOut);
    }

    // REGIST_MATMUL_OBJ owns the AIC service path; synchronize the AIV workers.
    // Batch scheduling is requested above so every AIV can reach this barrier.
    AscendC::SetFlag<AscendC::HardEvent::MTE3_S>(EVENT_ID0);
    AscendC::WaitFlag<AscendC::HardEvent::MTE3_S>(EVENT_ID0);
    AscendC::SyncAll<true>();

    const int32_t groups = (batch + BATCH_GROUP - 1) / BATCH_GROUP;
    for (int32_t group = wid; group < groups; group += workers) {
        const int32_t firstBatch = group * BATCH_GROUP;
        const int32_t countBatch = batch - firstBatch < BATCH_GROUP ?
            batch - firstBatch : BATCH_GROUP;
        auto output = oq.AllocTensor<float>();
        for (int32_t j = 0; j < countBatch; ++j) {
            const int32_t bi = firstBatch + j;
            float score = 0.0f;
            for (int32_t mt = 0; mt < tilesPerBatch; ++mt) {
                const int64_t slot = (static_cast<int64_t>(bi) * tilesPerBatch + mt) * PARTIAL_STRIDE;
                score += pg.GetValue(slot);
            }
            output.SetValue(j, score);
        }
        AscendC::SetFlag<AscendC::HardEvent::S_MTE3>(EVENT_ID0);
        AscendC::WaitFlag<AscendC::HardEvent::S_MTE3>(EVENT_ID0);
        oq.EnQue(output);
        output = oq.DeQue<float>();
        AscendC::DataCopyExtParams cp{
            1, static_cast<uint32_t>(countBatch * sizeof(float)), 0, 0, 0};
        AscendC::DataCopyPad(yg[firstBatch], output, cp);
        oq.FreeTensor(output);
    }
}

template<class T, bool TA, bool TB>
void LaunchTyped(uint32_t cores, aclrtStream stream, GM_ADDR a, GM_ADDR b, GM_ADDR y,
    GM_ADDR ws, AscendC::tiling::TCubeTiling tiling,
    int32_t batch, int32_t m, int32_t n, int32_t k,
    int32_t tileRows, int32_t tilesPerBatch)
{
    const int32_t workers = static_cast<int32_t>(2 * cores);
    const size_t partialBytes = static_cast<size_t>(batch) * tilesPerBatch *
        PARTIAL_STRIDE * sizeof(float);
    GM_ADDR tiles = ws + partialBytes;
    GM_ADDR systemWs = tiles + static_cast<size_t>(workers) * MAX_ROWS *
        tiling.baseN * sizeof(float);
    FlashMaxSum<T, TA, TB><<<cores, nullptr, stream>>>(a, b, y, ws, tiles, systemWs,
        tiling, batch, m, n, k, tileRows, tilesPerBatch, workers);
}

template<class T>
void Dispatch(bool ta, bool tb, uint32_t cores, aclrtStream stream,
    GM_ADDR a, GM_ADDR b, GM_ADDR y, GM_ADDR ws,
    AscendC::tiling::TCubeTiling tiling,
    int32_t batch, int32_t m, int32_t n, int32_t k,
    int32_t tileRows, int32_t tilesPerBatch)
{
    if (ta && tb) LaunchTyped<T, true, true>(cores, stream, a, b, y, ws,
        tiling, batch, m, n, k, tileRows, tilesPerBatch);
    else if (ta) LaunchTyped<T, true, false>(cores, stream, a, b, y, ws,
        tiling, batch, m, n, k, tileRows, tilesPerBatch);
    else if (tb) LaunchTyped<T, false, true>(cores, stream, a, b, y, ws,
        tiling, batch, m, n, k, tileRows, tilesPerBatch);
    else LaunchTyped<T, false, false>(cores, stream, a, b, y, ws,
        tiling, batch, m, n, k, tileRows, tilesPerBatch);
}
} // namespace bmms_parallel_gm

extern "C" void run_kernel(GM_ADDR x1, const TensorGroupInfo& info_x1,
    GM_ADDR x2, const TensorGroupInfo& info_x2, GM_ADDR y, const TensorGroupInfo& info_y,
    int64_t availableCoreNum, aclrtStream stream, bool transposeX1, bool transposeX2)
{
    (void)info_y;
    const auto& a = info_x1.tensors[0];
    const auto& b = info_x2.tensors[0];
    const int32_t batch = a.shape[0], m = a.shape[transposeX1 ? 2 : 1];
    const int32_t k = a.shape[transposeX1 ? 1 : 2];
    const int32_t n = b.shape[transposeX2 ? 1 : 2];
    if (availableCoreNum <= 0 || (a.dtype != 1 && a.dtype != 2) || a.dtype != b.dtype) return;
    const int32_t bn = n >= 128 ? 128 : (n + 15) / 16 * 16;
    const int32_t tileM = m < bmms_parallel_gm::MAX_ROWS ? m : bmms_parallel_gm::MAX_ROWS;
    const int32_t tileN = n < bn ? n : bn;

    auto platform = platform_ascendc::PlatformAscendCManager::GetInstance();
    if (platform == nullptr) return;
    matmul_tiling::MultiCoreMatmulTiling api(*platform);
    const auto dtype = a.dtype == 1 ? matmul_tiling::DataType::DT_FLOAT16 :
        matmul_tiling::DataType::DT_BF16;
    api.SetDim(1);
    api.SetAType(matmul_tiling::TPosition::GM, matmul_tiling::CubeFormat::ND,
        dtype, transposeX1);
    api.SetBType(matmul_tiling::TPosition::GM, matmul_tiling::CubeFormat::ND,
        dtype, transposeX2);
    api.SetCType(matmul_tiling::TPosition::GM, matmul_tiling::CubeFormat::ND,
        matmul_tiling::DataType::DT_FLOAT);
    api.SetOrgShape(m, n, k);
    api.SetShape(tileM, tileN, k);
    api.SetSingleShape(tileM, tileN, k);
    api.SetFixSplit(bmms_parallel_gm::MAX_ROWS, bn, -1);
    api.EnableBias(false);
    api.SetBufferSpace(-1, -1, 96 * 1024);
    AscendC::tiling::TCubeTiling tiling{};
    if (api.GetTiling(tiling) == -1) return;
    if (tiling.baseM <= 0 || tiling.baseM > bmms_parallel_gm::MAX_ROWS ||
        tiling.baseN <= 0 || tiling.baseN > 128) return;
    tiling.M = m; tiling.N = n; tiling.Ka = k; tiling.Kb = k;

    const int32_t tileRows = tiling.baseM;
    const int32_t tilesPerBatch = (m + tileRows - 1) / tileRows;
    const uint32_t totalTiles = static_cast<uint32_t>(batch * tilesPerBatch);
    const uint32_t needCores = (totalTiles + 1) / 2;
    const uint32_t cores = availableCoreNum < needCores ? availableCoreNum : needCores;
    const size_t partialBytes = static_cast<size_t>(totalTiles) *
        bmms_parallel_gm::PARTIAL_STRIDE * sizeof(float);
    const size_t tileBytes = static_cast<size_t>(2 * cores) *
        bmms_parallel_gm::MAX_ROWS * tiling.baseN * sizeof(float);
    const size_t sys = static_cast<size_t>(platform->GetLibApiWorkSpaceSize());
    void* allocation = nullptr;
    if (aclrtMalloc(&allocation, partialBytes + tileBytes + sys, ACL_MEM_MALLOC_HUGE_FIRST) != ACL_SUCCESS) return;
    GM_ADDR ws = (GM_ADDR)allocation;
    if (a.dtype == 1) bmms_parallel_gm::Dispatch<half>(transposeX1, transposeX2,
        cores, stream, x1, x2, y, ws, tiling, batch, m, n, k, tileRows, tilesPerBatch);
    else bmms_parallel_gm::Dispatch<bfloat16_t>(transposeX1, transposeX2,
        cores, stream, x1, x2, y, ws, tiling, batch, m, n, k, tileRows, tilesPerBatch);
    (void)aclrtSynchronizeStream(stream);
    aclrtFree(allocation);
}
