// EXPERIMENT ONLY: team v5.2 plus local C output on complete M/N tiles.
// Keep the team's verified source as the rollback version.
// v5.2 candidate: only folded row-max changes relative to passing submission 327186.
// Set BMMS_FOLDED_MAX to 0 to restore the v5.1 reduction. Requires NPU evaluation.
#ifndef BMMS_FOLDED_MAX
#define BMMS_FOLDED_MAX 1
#endif
// v5.1 candidate: restore supplied v4 general path; retain only vector dot specialization.
// Each kernel uses its own execution qualifier; no default kernel-type macro.
#ifndef BMMS_VECTOR_DOT
#define BMMS_VECTOR_DOT 1
#endif
#include <cstddef>
#include <cstdint>
#include "acl/acl.h"
#include "kernel_operator.h"
#include "kernel_tiling/kernel_tiling.h"
#include "tiling/platform/platform_ascendc.h"
#include "tiling/tiling_api.h"
#include "lib/matmul_intf.h"

// TensorInfo and TensorGroupInfo are supplied by the competition runner.
// Candidate v4: adaptive 32/64-row tiles; preserve the passed v3 reduction path.
// v3: submission 325226, Pass, 19.58 points. This v4 needs hardware evaluation.
namespace bmms_v2 {
constexpr int32_t ROWS = 32;
constexpr int32_t WIDE_ROWS = 64;
constexpr int32_t MAX_COLS = 256;
constexpr int32_t OUTPUT_GROUP = 16; // Disjoint 64-byte output cache lines.
constexpr int32_t REDUCE_SCRATCH_BYTES = 4096; // FP32 ReduceSum count <= 8192.

template<bool LOCAL> struct CTileLoad;

template<> struct CTileLoad<true> {
    template<class MatmulT>
    __aicore__ static inline AscendC::LocalTensor<float> Run(
        MatmulT& mm, AscendC::TQue<AscendC::TPosition::VECIN, 1>& cq,
        const AscendC::GlobalTensor<float>& cg, int32_t elements)
    {
        (void)cg;
        (void)elements;
        auto c = cq.AllocTensor<float>();
        while (mm.template Iterate<true>()) {
            mm.template GetTensorC<true>(c, 0, true);
        }
        mm.End();
        return c;
    }
};

template<> struct CTileLoad<false> {
    template<class MatmulT>
    __aicore__ static inline AscendC::LocalTensor<float> Run(
        MatmulT& mm, AscendC::TQue<AscendC::TPosition::VECIN, 1>& cq,
        const AscendC::GlobalTensor<float>& cg, int32_t elements)
    {
        mm.template IterateAll<true>(cg, 0, false);
        mm.End();
        auto c = cq.AllocTensor<float>();
        AscendC::DataCopy(c, cg, elements);
        return c;
    }
};

// BEGIN_HOST_PLAN -- also extracted and compiled by the CPU planner tests.
struct WorkPlan {
    int32_t cores;
    int32_t workers;
    int32_t nParts;
    int32_t nTilesPerPart;
    int32_t tasks;
    int32_t rows;
};

inline WorkPlan PlanWithRows(int32_t batch, int32_t m, int32_t n,
                            int32_t baseN, int32_t availableCores, int32_t tileRows)
{
    const int32_t mTiles = (m + tileRows - 1) / tileRows;
    const int32_t bmTasks = batch * mTiles;
    const int32_t nTiles = (n + baseN - 1) / baseN;
    // Split N only when B*M tiling alone cannot fill the available AIVs.
    int32_t wantedParts = (2 * availableCores + bmTasks - 1) / bmTasks;
    if (wantedParts > nTiles) wantedParts = nTiles;
    const int32_t perPart = (nTiles + wantedParts - 1) / wantedParts;
    const int32_t nParts = (nTiles + perPart - 1) / perPart;
    const int32_t tasks = bmTasks * nParts;
    int32_t cores = (tasks + 1) / 2;
    if (cores > availableCores) cores = availableCores;
    return {cores, 2 * cores, nParts, perPart, tasks, tileRows};
}

inline WorkPlan MakePlan(int32_t batch, int32_t m, int32_t n,
                         int32_t baseN, int32_t availableCores)
{
    const auto narrow = PlanWithRows(batch, m, n, baseN, availableCores, ROWS);
    if (m < WIDE_ROWS) return narrow;
    const auto wide = PlanWithRows(batch, m, n, baseN, availableCores, WIDE_ROWS);
    // Enlarge tiles only if the original launch width is preserved and every
    // originally launched AIV can still receive at least one task.
    if (wide.workers == narrow.workers && wide.tasks >= narrow.workers) return wide;
    return narrow;
}
// END_HOST_PLAN

inline size_t Align512(size_t bytes) { return (bytes + 511) / 512 * 512; }

// BEGIN_ROW_MAX -- exact helper is exercised with a CPU instruction model.
__aicore__ inline void MergeRowMax(const AscendC::LocalTensor<float>& running,
    const AscendC::LocalTensor<float>& chunkMax, const AscendC::LocalTensor<float>& c,
    int32_t validM, int32_t validN, int32_t baseN, bool firstTile)
{
#if BMMS_FOLDED_MAX
    // Fold 64-column segments in-place, then perform ONE horizontal max.
    // Only valid tail lanes are touched; unwritten GM tail data is never used.
    const uint8_t stride = static_cast<uint8_t>(baseN / 8);
    const AscendC::BinaryRepeatParams repeat{1, 1, 1, stride, stride, stride};
    for (int32_t col = 64; col < validN; col += 64) {
        const uint64_t width = validN - col < 64 ? validN - col : 64;
        AscendC::Max<float>(c, c, c[col], width, static_cast<uint8_t>(validM), repeat);
        AscendC::PipeBarrier<PIPE_V>();
    }
    const int32_t width = validN < 64 ? validN : 64;
    if (firstTile) {
        AscendC::WholeReduceMax<float>(running, c, width, validM,
            1, 1, baseN / 8, AscendC::ReduceOrder::ORDER_ONLY_VALUE);
        AscendC::PipeBarrier<PIPE_V>();
    } else {
        AscendC::WholeReduceMax<float>(chunkMax, c, width, validM,
            1, 1, baseN / 8, AscendC::ReduceOrder::ORDER_ONLY_VALUE);
        AscendC::PipeBarrier<PIPE_V>();
        AscendC::Max(running, running, chunkMax, validM);
        AscendC::PipeBarrier<PIPE_V>();
    }
#else
    // One repeat per row, at most 64 FP32 columns per repeat on A2.
    // ONLY_VALUE makes dstRepStride=1 mean one float; source strides use 32 B.
    // col advances by 256 B, preserving the queue's required 32 B alignment.
    // Masks exclude all unwritten tail lanes.
    for (int32_t col = 0; col < validN; col += 64) {
        const int32_t width = validN - col < 64 ? validN - col : 64;
        if (firstTile && col == 0) {
            AscendC::WholeReduceMax<float>(running, c[col], width, validM,
                1, 1, baseN / 8, AscendC::ReduceOrder::ORDER_ONLY_VALUE);
            AscendC::PipeBarrier<PIPE_V>();
        } else {
            AscendC::WholeReduceMax<float>(chunkMax, c[col], width, validM,
                1, 1, baseN / 8, AscendC::ReduceOrder::ORDER_ONLY_VALUE);
            AscendC::PipeBarrier<PIPE_V>();
            AscendC::Max(running, running, chunkMax, validM);
            AscendC::PipeBarrier<PIPE_V>();
        }
    }
#endif
}
// END_ROW_MAX

#if BMMS_VECTOR_DOT
// M=N=1 is a dot product for all four storage layouts.
// One AIV owns a complete 64-byte output group, preventing partial-line races.
template<class T>
__global__ __vector__ void VectorDot(GM_ADDR a, GM_ADDR b, GM_ADDR y,
                                int32_t batch, int32_t k)
{
    AscendC::TPipe pipe;
    AscendC::GlobalTensor<T> ag, bg;
    AscendC::GlobalTensor<float> yg;
    ag.SetGlobalBuffer(reinterpret_cast<__gm__ T*>(a));
    bg.SetGlobalBuffer(reinterpret_cast<__gm__ T*>(b));
    yg.SetGlobalBuffer(reinterpret_cast<__gm__ float*>(y));
    const int32_t paddedK = (k + 15) / 16 * 16;
    AscendC::TQue<AscendC::TPosition::VECIN, 1> aq, bq;
    AscendC::TQue<AscendC::TPosition::VECOUT, 1> oq;
    AscendC::TBuf<AscendC::TPosition::VECCALC> afBuf, bfBuf, scratch, scalarBuf;
    pipe.InitBuffer(aq, 1, paddedK * sizeof(T));
    pipe.InitBuffer(bq, 1, paddedK * sizeof(T));
    pipe.InitBuffer(oq, 1, OUTPUT_GROUP * sizeof(float));
    pipe.InitBuffer(afBuf, paddedK * sizeof(float));
    pipe.InitBuffer(bfBuf, paddedK * sizeof(float));
    pipe.InitBuffer(scratch, REDUCE_SCRATCH_BYTES);
    pipe.InitBuffer(scalarBuf, 32);
    auto af = afBuf.Get<float>();
    auto bf = bfBuf.Get<float>();
    auto tmp = scratch.Get<float>();
    auto scalar = scalarBuf.Get<float>();
    const int32_t first = AscendC::GetBlockIdx() * OUTPUT_GROUP;
    const int32_t count = batch - first < OUTPUT_GROUP ? batch - first : OUTPUT_GROUP;
    auto out = oq.AllocTensor<float>();
    for (int32_t j = 0; j < count; ++j) {
        auto al = aq.AllocTensor<T>();
        auto bl = bq.AllocTensor<T>();
        const int64_t offset = static_cast<int64_t>(first + j) * k;
        // Byte-count copies support K=8 mod 16 without reading past input.
        AscendC::DataCopyExtParams cp{1, static_cast<uint32_t>(k * sizeof(T)), 0, 0, 0};
        AscendC::DataCopyPadExtParams<T> pad{false, 0, 0, 0};
        AscendC::DataCopyPad(al, ag[offset], cp, pad);
        AscendC::DataCopyPad(bl, bg[offset], cp, pad);
        aq.EnQue(al);
        bq.EnQue(bl);
        al = aq.DeQue<T>();
        bl = bq.DeQue<T>();
        AscendC::Cast(af, al, AscendC::RoundMode::CAST_NONE, k);
        AscendC::Cast(bf, bl, AscendC::RoundMode::CAST_NONE, k);
        AscendC::PipeBarrier<PIPE_V>();
        AscendC::Mul(af, af, bf, k);
        AscendC::PipeBarrier<PIPE_V>();
        AscendC::ReduceSum(scalar, af, tmp, k);
        AscendC::SetFlag<AscendC::HardEvent::V_S>(EVENT_ID0);
        AscendC::WaitFlag<AscendC::HardEvent::V_S>(EVENT_ID0);
        out.SetValue(j, scalar.GetValue(0));
        aq.FreeTensor(al);
        bq.FreeTensor(bl);
    }
    AscendC::SetFlag<AscendC::HardEvent::S_MTE3>(EVENT_ID0);
    AscendC::WaitFlag<AscendC::HardEvent::S_MTE3>(EVENT_ID0);
    oq.EnQue(out);
    out = oq.DeQue<float>();
    AscendC::DataCopyExtParams cp{1, static_cast<uint32_t>(count * sizeof(float)), 0, 0, 0};
    AscendC::DataCopyPad(yg[first], out, cp);
    oq.FreeTensor(out);
}
#endif

template<class T, bool TA, bool TB, bool LOCAL>
__schedmode__(1) __global__ __mix__(1, 2) void ParallelMaxSum(
    GM_ADDR a, GM_ADDR b, GM_ADDR y, GM_ADDR tiles, GM_ADDR partials,
    __kfc_workspace__ GM_ADDR workspace, AscendC::tiling::TCubeTiling tiling,
    int32_t batch, int32_t m, int32_t n, int32_t k,
    int32_t workers, int32_t nParts, int32_t nTilesPerPart, int32_t tileRows)
{
    AscendC::TPipe pipe;
    matmul::Matmul<
        matmul::MatmulType<AscendC::TPosition::GM, CubeFormat::ND, T, TA>,
        matmul::MatmulType<AscendC::TPosition::GM, CubeFormat::ND, T, TB>,
        matmul::MatmulType<LOCAL ? AscendC::TPosition::VECIN : AscendC::TPosition::GM,
            CubeFormat::ND, float>,
        matmul::MatmulType<AscendC::TPosition::GM, CubeFormat::ND, float>> mm;
    // The macro runs the Matmul service on AIC. The following body is AIV work.
    REGIST_MATMUL_OBJ(&pipe, GetSysWorkSpacePtr(), mm, &tiling);

    const int32_t worker = AscendC::GetBlockIdx();
    const int32_t mTiles = (m + tileRows - 1) / tileRows;
    const int32_t mPadded = mTiles * tileRows;
    const int32_t tileElems = tileRows * tiling.baseN;
    const int32_t inputElems = tileElems > mPadded ? tileElems : mPadded;
    const int32_t reduceElems = tileRows * 8 > mPadded ? tileRows * 8 : mPadded;
    const int32_t taskCount = batch * mTiles * nParts;

    AscendC::GlobalTensor<T> ag, bg;
    AscendC::GlobalTensor<float> yg, cg, pg;
    ag.SetGlobalBuffer(reinterpret_cast<__gm__ T*>(a));
    bg.SetGlobalBuffer(reinterpret_cast<__gm__ T*>(b));
    yg.SetGlobalBuffer(reinterpret_cast<__gm__ float*>(y));
    cg.SetGlobalBuffer(reinterpret_cast<__gm__ float*>(tiles) +
                       static_cast<int64_t>(worker) * tileElems);
    pg.SetGlobalBuffer(reinterpret_cast<__gm__ float*>(partials));

    AscendC::TQue<AscendC::TPosition::VECIN, 1> cq;
    AscendC::TQue<AscendC::TPosition::VECOUT, 1> oq;
    AscendC::TBuf<AscendC::TPosition::VECCALC> scratch, reduced, scalarBuffer;
    pipe.InitBuffer(cq, 1, inputElems * sizeof(float));
    pipe.InitBuffer(oq, 1, tileRows * sizeof(float));
    pipe.InitBuffer(scratch, REDUCE_SCRATCH_BYTES);
    pipe.InitBuffer(reduced, reduceElems * sizeof(float));
    pipe.InitBuffer(scalarBuffer, 32);
    auto tmp = scratch.Get<float>();
    auto tileMax = reduced.Get<float>();
    auto mergedRows = reduced.Get<float>();
    auto scalar = scalarBuffer.Get<float>();

    // Each task writes a distinct, fully initialized 128/256-byte row tile.
    // No work is conditional on input values or on any known test fixture.
    for (int32_t task = worker; task < taskCount; task += workers) {
        const int32_t mTile = task % mTiles;
        const int32_t batchPart = task / mTiles;
        const int32_t part = batchPart % nParts;
        const int32_t bi = batchPart / nParts;
        const int32_t mi = mTile * tileRows;
        const int32_t validM = m - mi < tileRows ? m - mi : tileRows;
        const int32_t firstN = part * nTilesPerPart * tiling.baseN;
        const int32_t partEnd = firstN + nTilesPerPart * tiling.baseN;
        const int32_t lastN = partEnd < n ? partEnd : n;
        const int64_t batchA = static_cast<int64_t>(bi) * m * k;
        const int64_t batchB = static_cast<int64_t>(bi) * k * n;
        const int64_t ao = batchA + (TA ? mi : static_cast<int64_t>(mi) * k);
        auto out = oq.AllocTensor<float>();
        // Padding stays zero. Valid rows are overwritten by the first max,
        // NOT compared with zero, so all-negative similarities remain correct.
        AscendC::Duplicate(out, 0.0f, tileRows);
        AscendC::PipeBarrier<PIPE_V>();

        for (int32_t ni = firstN; ni < lastN; ni += tiling.baseN) {
            const int32_t validN = lastN - ni < tiling.baseN ? lastN - ni : tiling.baseN;
            const int64_t bo = batchB + (TB ? static_cast<int64_t>(ni) * k : ni);
            // Preserve physical input strides, and explicitly specify C's stride.
            mm.SetOrgShape(m, n, k, k, tiling.baseN);
            mm.SetTail(validM, validN, k);
            mm.SetTensorA(ag[ao], TA);
            mm.SetTensorB(bg[bo], TB);
            auto c = CTileLoad<LOCAL>::Run(mm, cq, cg, validM * tiling.baseN);
            cq.EnQue(c);
            c = cq.DeQue<float>();
            MergeRowMax(out, tileMax, c, validM, validN, tiling.baseN, ni == firstN);
            cq.FreeTensor(c);
        }

        // VECOUT EnQue/DeQue orders the vector writes before the GM copy.
        oq.EnQue(out);
        out = oq.DeQue<float>();
        const int64_t partialOffset = (static_cast<int64_t>(bi) * nParts + part) * mPadded + mi;
        AscendC::DataCopy(pg[partialOffset], out, tileRows);
        oq.FreeTensor(out);
    }

    // Every launched AIV participates, including AIVs with no assigned tasks.
    // Matmul has completed above. Only AIV writers/readers require this barrier;
    // SyncAll<false> would incorrectly ask the AIC service to join our epilogue.
    // Batch scheduling prevents partial-dispatch deadlock in concurrent streams.
    AscendC::PipeBarrier<PIPE_ALL>();
    AscendC::SyncAll<true>();

    // Keep N-max BEFORE M-sum. Do not add partial N scores or use output atomics.
    // Output ownership is still grouped by 16 floats to avoid cache-line races.
    const int32_t outGroups = (batch + OUTPUT_GROUP - 1) / OUTPUT_GROUP;
    for (int32_t group = worker; group < outGroups; group += workers) {
        const int32_t firstBatch = group * OUTPUT_GROUP;
        const int32_t count = batch - firstBatch < OUTPUT_GROUP ? batch - firstBatch : OUTPUT_GROUP;
        auto out = oq.AllocTensor<float>();
        for (int32_t j = 0; j < count; ++j) {
            const int32_t bi = firstBatch + j;
            for (int32_t part = 0; part < nParts; ++part) {
                auto c = cq.AllocTensor<float>();
                const int64_t offset = (static_cast<int64_t>(bi) * nParts + part) * mPadded;
                AscendC::DataCopy(c, pg[offset], mPadded);
                cq.EnQue(c);
                c = cq.DeQue<float>();
                if (nParts == 1) {
                    AscendC::ReduceSum(scalar, c, tmp, m);
                    AscendC::SetFlag<AscendC::HardEvent::V_S>(EVENT_ID0);
                    AscendC::WaitFlag<AscendC::HardEvent::V_S>(EVENT_ID0);
                } else {
                    if (part == 0) AscendC::Max(mergedRows, c, c, mPadded);
                    else AscendC::Max(mergedRows, mergedRows, c, mPadded);
                    AscendC::PipeBarrier<PIPE_V>();
                }
                cq.FreeTensor(c);
            }
            if (nParts != 1) {
                AscendC::ReduceSum(scalar, mergedRows, tmp, m);
                AscendC::SetFlag<AscendC::HardEvent::V_S>(EVENT_ID0);
                AscendC::WaitFlag<AscendC::HardEvent::V_S>(EVENT_ID0);
            }
            out.SetValue(j, scalar.GetValue(0));
        }
        AscendC::SetFlag<AscendC::HardEvent::S_MTE3>(EVENT_ID0);
        AscendC::WaitFlag<AscendC::HardEvent::S_MTE3>(EVENT_ID0);
        oq.EnQue(out);
        out = oq.DeQue<float>();
        AscendC::DataCopyExtParams cp{1, static_cast<uint32_t>(count * sizeof(float)), 0, 0, 0};
        AscendC::DataCopyPad(yg[firstBatch], out, cp);
        oq.FreeTensor(out);
    }
}

template<class T, bool TA, bool TB, bool LOCAL>
void LaunchTyped(const WorkPlan& plan, aclrtStream stream,
                 GM_ADDR a, GM_ADDR b, GM_ADDR y, GM_ADDR ws,
                 AscendC::tiling::TCubeTiling tiling,
                 int32_t batch, int32_t m, int32_t n, int32_t k)
{
    const size_t tileBytes = static_cast<size_t>(plan.workers) * plan.rows * tiling.baseN * sizeof(float);
    const size_t paddedM = (m + plan.rows - 1) / plan.rows * plan.rows;
    const size_t partialBytes = static_cast<size_t>(batch) * plan.nParts * paddedM * sizeof(float);
    GM_ADDR systemWs = ws + Align512(tileBytes + partialBytes);
    ParallelMaxSum<T, TA, TB, LOCAL><<<plan.cores, nullptr, stream>>>(a, b, y, ws, ws + tileBytes,
        systemWs, tiling, batch, m, n, k, plan.workers, plan.nParts, plan.nTilesPerPart, plan.rows);
}

template<class T, bool LOCAL>
void Dispatch(bool ta, bool tb, const WorkPlan& plan, aclrtStream stream,
              GM_ADDR a, GM_ADDR b, GM_ADDR y, GM_ADDR ws,
              AscendC::tiling::TCubeTiling tiling,
              int32_t batch, int32_t m, int32_t n, int32_t k)
{
    if (ta && tb) LaunchTyped<T, true, true, LOCAL>(plan, stream, a, b, y, ws, tiling, batch, m, n, k);
    else if (ta) LaunchTyped<T, true, false, LOCAL>(plan, stream, a, b, y, ws, tiling, batch, m, n, k);
    else if (tb) LaunchTyped<T, false, true, LOCAL>(plan, stream, a, b, y, ws, tiling, batch, m, n, k);
    else LaunchTyped<T, false, false, LOCAL>(plan, stream, a, b, y, ws, tiling, batch, m, n, k);
}
} // namespace bmms_v2

extern "C" void run_kernel(GM_ADDR x1, const TensorGroupInfo& info_x1,
    GM_ADDR x2, const TensorGroupInfo& info_x2, GM_ADDR y, const TensorGroupInfo& info_y,
    int64_t availableCoreNum, aclrtStream stream, bool transposeX1, bool transposeX2)
{
    (void)info_y;
    const auto& a = info_x1.tensors[0];
    const auto& b = info_x2.tensors[0];
    const int32_t batch = a.shape[0], m = a.shape[transposeX1 ? 2 : 1];
    const int32_t k = a.shape[transposeX1 ? 1 : 2], n = b.shape[transposeX2 ? 1 : 2];
    if (availableCoreNum <= 0 || (a.dtype != 1 && a.dtype != 2) || a.dtype != b.dtype) return;
#if BMMS_VECTOR_DOT
    if (m == 1 && n == 1) {
        const int32_t groups = (batch + bmms_v2::OUTPUT_GROUP - 1) / bmms_v2::OUTPUT_GROUP;
        if (a.dtype == 1)
            bmms_v2::VectorDot<half><<<groups, nullptr, stream>>>(x1, x2, y, batch, k);
        else
            bmms_v2::VectorDot<bfloat16_t><<<groups, nullptr, stream>>>(x1, x2, y, batch, k);
        return; // No scratch allocation or host synchronization on this path.
    }
#endif
    const int32_t bn = n >= bmms_v2::MAX_COLS ? bmms_v2::MAX_COLS : (n + 15) / 16 * 16;
    const int32_t tileN = n < bn ? n : bn;
    auto platform = platform_ascendc::PlatformAscendCManager::GetInstance();
    if (platform == nullptr) return;
    // Do not launch more Cube groups than the runner's available hardware count.
    auto plan = bmms_v2::MakePlan(batch, m, n, bn, static_cast<int32_t>(availableCoreNum));
    const auto dtype = a.dtype == 1 ? matmul_tiling::DataType::DT_FLOAT16 : matmul_tiling::DataType::DT_BF16;
    AscendC::tiling::TCubeTiling tiling{};
    bool tilingOk = false;
    bool useLocal = false;
    for (int32_t rowAttempt = 0; rowAttempt < 2 && !tilingOk; ++rowAttempt) {
        const int32_t tileM = m < plan.rows ? m : plan.rows;
        // Wide rows are only chosen for M >= 64; small M retains v3's 16/32.
        const int32_t baseM = tileM <= 16 ? 16 : plan.rows;
        // GetTensorC uses contiguous baseM x baseN output; keep all tails on
        // the team's proven GM path. If local tiling fails, retry GM first.
        const bool fullTiles = m >= plan.rows && m % plan.rows == 0 &&
            n >= bn && n % bn == 0;
        for (int32_t mode = 0; mode < (fullTiles ? 2 : 1); ++mode) {
            const bool localAttempt = fullTiles && mode == 0;
            matmul_tiling::MultiCoreMatmulTiling api(*platform);
            api.SetDim(1);
            api.SetAType(matmul_tiling::TPosition::GM, matmul_tiling::CubeFormat::ND, dtype, transposeX1);
            api.SetBType(matmul_tiling::TPosition::GM, matmul_tiling::CubeFormat::ND, dtype, transposeX2);
            api.SetCType(localAttempt ? matmul_tiling::TPosition::VECIN : matmul_tiling::TPosition::GM,
                matmul_tiling::CubeFormat::ND, matmul_tiling::DataType::DT_FLOAT);
            api.SetOrgShape(m, n, k);
            api.SetShape(tileM, tileN, k);
            api.SetSingleShape(tileM, tileN, k);
            api.SetFixSplit(baseM, bn, -1);
            api.EnableBias(false);
            // Worst-case user UB is 102,688 B; + 65,536 B Matmul < 192 KiB.
            api.SetBufferSpace(-1, -1, 64 * 1024);
            tiling = AscendC::tiling::TCubeTiling{};
            const int32_t status = api.GetTiling(tiling);
            if (status != -1 && tiling.baseN == bn && tiling.baseM == baseM) {
                tilingOk = true;
                useLocal = localAttempt;
                break;
            }
        }
        if (!tilingOk) {
            if (plan.rows == bmms_v2::ROWS) return;
            plan = bmms_v2::PlanWithRows(batch, m, n, bn,
                static_cast<int32_t>(availableCoreNum), bmms_v2::ROWS);
        }
    }
    if (!tilingOk) return;
    tiling.M = m; tiling.N = n; tiling.Ka = k; tiling.Kb = k;

    const size_t tileBytes = static_cast<size_t>(plan.workers) * plan.rows * bn * sizeof(float);
    const size_t paddedM = (m + plan.rows - 1) / plan.rows * plan.rows;
    const size_t partialBytes = static_cast<size_t>(batch) * plan.nParts * paddedM * sizeof(float);
    const size_t sysBytes = static_cast<size_t>(platform->GetLibApiWorkSpaceSize());
    void* allocation = nullptr;
    if (aclrtMalloc(&allocation, bmms_v2::Align512(tileBytes + partialBytes) + sysBytes,
                    ACL_MEM_MALLOC_HUGE_FIRST) != ACL_SUCCESS) return;
    GM_ADDR ws = (GM_ADDR)allocation; // Explicit Ascend address-space conversion, as in the supplied runner.
    if (a.dtype == 1) {
        if (useLocal) bmms_v2::Dispatch<half, true>(transposeX1, transposeX2, plan, stream, x1, x2, y, ws, tiling, batch, m, n, k);
        else bmms_v2::Dispatch<half, false>(transposeX1, transposeX2, plan, stream, x1, x2, y, ws, tiling, batch, m, n, k);
    } else {
        if (useLocal) bmms_v2::Dispatch<bfloat16_t, true>(transposeX1, transposeX2, plan, stream, x1, x2, y, ws, tiling, batch, m, n, k);
        else bmms_v2::Dispatch<bfloat16_t, false>(transposeX1, transposeX2, plan, stream, x1, x2, y, ws, tiling, batch, m, n, k);
    }
    // Scratch is private per call and remains live until this stream completes.
    (void)aclrtSynchronizeStream(stream);
    aclrtFree(allocation);
}
