// Independent multi-case runner; the competition main.asc is unchanged.
#include <cstdint>
#include <cstdio>
#include <cstdlib>
#include <cerrno>
#include <exception>
#include <fstream>
#include <stdexcept>
#include <string>
#include "acl/acl.h"

#ifndef TENSOR_GROUP_INFO_DEFINED
#define TENSOR_GROUP_INFO_DEFINED
struct TensorInfo {
    const int64_t* shape;
    int64_t numDims;
    int32_t dtype;
};
struct TensorGroupInfo {
    const TensorInfo* tensors;
    int64_t numTensors;
};
#endif

#include "../kernel.asc"

namespace {
void CheckAcl(aclError result, const char* operation)
{
    if (result != ACL_SUCCESS) {
        throw std::runtime_error(std::string(operation) + " failed, ret=" + std::to_string(result));
    }
}

int64_t ParseInteger(const char* text, int64_t low, int64_t high)
{
    errno = 0;
    char* end = nullptr;
    const long long value = std::strtoll(text, &end, 10);
    if (errno != 0 || end == text || *end != '\0' || value < low || value > high) {
        throw std::runtime_error(std::string("Invalid integer argument: ") + text);
    }
    return static_cast<int64_t>(value);
}

struct Runtime {
    bool initialized = false;
    bool deviceSelected = false;
    int32_t device = 0;
    aclrtStream stream = nullptr;
    ~Runtime()
    {
        if (stream) aclrtDestroyStream(stream);
        if (deviceSelected) aclrtResetDevice(device);
        if (initialized) aclFinalize();
    }
};

struct Buffer {
    uint8_t* host = nullptr;
    uint8_t* device = nullptr;
    size_t bytes = 0;
    void Allocate(size_t size)
    {
        bytes = size;
        CheckAcl(aclrtMallocHost(reinterpret_cast<void**>(&host), size), "aclrtMallocHost");
        CheckAcl(aclrtMalloc(reinterpret_cast<void**>(&device), size, ACL_MEM_MALLOC_HUGE_FIRST), "aclrtMalloc");
    }
    void Read(const std::string& path)
    {
        std::ifstream file(path, std::ios::binary | std::ios::ate);
        if (!file || file.tellg() != static_cast<std::streamoff>(bytes)) {
            throw std::runtime_error("Missing input or incorrect byte count: " + path);
        }
        file.seekg(0);
        if (!file.read(reinterpret_cast<char*>(host), static_cast<std::streamsize>(bytes))) {
            throw std::runtime_error("Cannot read input: " + path);
        }
        CheckAcl(aclrtMemcpy(device, bytes, host, bytes, ACL_MEMCPY_HOST_TO_DEVICE), "input copy");
    }
    void Write(const std::string& path)
    {
        CheckAcl(aclrtMemcpy(host, bytes, device, bytes, ACL_MEMCPY_DEVICE_TO_HOST), "output copy");
        std::ofstream file(path, std::ios::binary | std::ios::trunc);
        if (!file.write(reinterpret_cast<const char*>(host), static_cast<std::streamsize>(bytes))) {
            throw std::runtime_error("Cannot write output: " + path);
        }
    }
    ~Buffer()
    {
        if (device) aclrtFree(device);
        if (host) aclrtFreeHost(host);
    }
};
} // namespace

int main(int argc, char** argv)
{
    if (argc < 9 || argc > 11) {
        std::fprintf(stderr, "Usage: %s CASE_DIR B M N K float16|bfloat16 TX1 TX2 [DEVICE=0] [TIMEOUT_MS=120000]\n", argv[0]);
        return 2;
    }
    try {
        const std::string directory(argv[1]);
        const int64_t batch = ParseInteger(argv[2], 1, 64);
        const int64_t m = ParseInteger(argv[3], 1, 8192);
        const int64_t n = ParseInteger(argv[4], 1, 8192);
        const int64_t k = ParseInteger(argv[5], 32, 8192);
        const std::string dtype(argv[6]);
        const bool tx1 = ParseInteger(argv[7], 0, 1) != 0;
        const bool tx2 = ParseInteger(argv[8], 0, 1) != 0;
        if (k % 8 != 0 || batch * m * k > (1LL << 26) || batch * n * k > (1LL << 26)) {
            throw std::runtime_error("Shape exceeds the problem constraints");
        }
        if (dtype != "float16" && dtype != "bfloat16") {
            throw std::runtime_error("dtype must be float16 or bfloat16");
        }
        const int32_t dtypeCode = dtype == "float16" ? 1 : 2;
        const int64_t x1Shape[] = {batch, tx1 ? k : m, tx1 ? m : k};
        const int64_t x2Shape[] = {batch, tx2 ? n : k, tx2 ? k : n};
        const int64_t yShape[] = {batch};
        const TensorInfo x1Tensor = {x1Shape, 3, dtypeCode};
        const TensorInfo x2Tensor = {x2Shape, 3, dtypeCode};
        const TensorInfo yTensor = {yShape, 1, 0};
        const TensorGroupInfo x1Info = {&x1Tensor, 1};
        const TensorGroupInfo x2Info = {&x2Tensor, 1};
        const TensorGroupInfo yInfo = {&yTensor, 1};
        const int32_t timeout = argc == 11 ? static_cast<int32_t>(ParseInteger(argv[10], 1, 2147483647)) : 120000;

        Runtime runtime;
        runtime.device = argc >= 10 ? static_cast<int32_t>(ParseInteger(argv[9], 0, 1024)) : 0;
        CheckAcl(aclInit(nullptr), "aclInit");
        runtime.initialized = true;
        CheckAcl(aclrtSetDevice(runtime.device), "aclrtSetDevice");
        runtime.deviceSelected = true;
        int64_t cores = 0;
        CheckAcl(aclrtGetDeviceInfo(runtime.device, ACL_DEV_ATTR_CUBE_CORE_NUM, &cores), "aclrtGetDeviceInfo");
        if (cores <= 0) throw std::runtime_error("Device exposes no Cube cores");
        CheckAcl(aclrtCreateStream(&runtime.stream), "aclrtCreateStream");

        Buffer x1, x2, y;
        x1.Allocate(static_cast<size_t>(batch * m * k) * 2);
        x2.Allocate(static_cast<size_t>(batch * n * k) * 2);
        y.Allocate(static_cast<size_t>(batch) * sizeof(float));
        x1.Read(directory + "/x1.bin");
        x2.Read(directory + "/x2.bin");
        // Unwritten FP32 output remains NaN and is rejected by the Python verifier.
        CheckAcl(aclrtMemset(y.device, y.bytes, 0xff, y.bytes), "output initialization");
        run_kernel(reinterpret_cast<GM_ADDR>(x1.device), x1Info,
                   reinterpret_cast<GM_ADDR>(x2.device), x2Info,
                   reinterpret_cast<GM_ADDR>(y.device), yInfo,
                   cores, runtime.stream, tx1, tx2);
        CheckAcl(aclrtSynchronizeStreamWithTimeout(runtime.stream, timeout), "kernel synchronization");
        y.Write(directory + "/actual_y.bin");
        std::printf("NPU completed: B=%lld M=%lld N=%lld K=%lld %s transpose=(%d,%d)\n",
                    static_cast<long long>(batch), static_cast<long long>(m),
                    static_cast<long long>(n), static_cast<long long>(k), dtype.c_str(), tx1, tx2);
        return 0;
    } catch (const std::exception& error) {
        std::fprintf(stderr, "[ERROR] %s\n", error.what());
        return 1;
    }
}
